# Puerto del servicio HTTP
PORT=3003

# Número de WhatsApp asociado a la sesión (requerido)
WHATSAPP_PHONE_NUMBER=

# Versión de WhatsApp Web a usar por Baileys.
# Tomar la marcada como "current" en https://wppconnect.io/whatsapp-versions
# Si se omite o es inválida, se usa el valor por defecto del código.
WA_VERSION=2.3000.1048136787
